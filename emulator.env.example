# Local demo against the Firebase emulators. Loaded by `npm run dev:demo`.
# Demo values only. A demo- project id can never reach a real Firebase project.
# Do not copy this file to .env.local; the script loads it for you.

# Browser Firebase config (fake values; the emulators accept any api key)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-tenderpaws.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-tenderpaws
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-tenderpaws.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo

# Browser emulator hosts
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
NEXT_PUBLIC_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Server (Admin SDK and server callables)
FIREBASE_PROJECT_ID=demo-tenderpaws
GCLOUD_PROJECT=demo-tenderpaws
FIREBASE_STORAGE_BUCKET=demo-tenderpaws.appspot.com
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# Service account credentials stay empty so no real credential is ever used.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
