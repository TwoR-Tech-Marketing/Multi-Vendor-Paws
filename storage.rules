rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ---------------------------------------------------------------
    // Phase 3 — Vendor-owned assets (logos, covers, product images, payouts)
    // Anyone can read (storefront browsing); only the owning vendor can
    // write under their own uid path.
    // ---------------------------------------------------------------
    match /vendors/{vendorId}/{rest=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == vendorId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Vendor signup logo uploads (pre-auth allowed via app)
    match /vendor_signup_requests/{requestId}/{file} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Vendor compliance documents (own uid only)
    match /vendor_documents/{vendorId}/{requirementId}/{file} {
      allow read: if request.auth != null &&
        (request.auth.uid == vendorId ||
          firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)));
      allow write: if request.auth != null
        && request.auth.uid == vendorId
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Telehealth chat photos. Session participants and admins read;
    // the sender uploads to its own folder while the session is active.
    // No delete rule (records stay).
    match /telehealth/{sessionId}/{uid}/{file} {
      allow read: if request.auth != null && (
        firestore.get(/databases/(default)/documents/telehealthSessions/$(sessionId)).data.buyerUid == request.auth.uid ||
        firestore.get(/databases/(default)/documents/telehealthSessions/$(sessionId)).data.doctorId == request.auth.uid ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)));
      allow write: if request.auth != null && request.auth.uid == uid
        && firestore.get(/databases/(default)/documents/telehealthSessions/$(sessionId)).data.status == "active"
        && (firestore.get(/databases/(default)/documents/telehealthSessions/$(sessionId)).data.buyerUid == uid
            || firestore.get(/databases/(default)/documents/telehealthSessions/$(sessionId)).data.doctorId == uid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic)');
    }

    // ---------------------------------------------------------------
    // Legacy paths used by the live mobile app + admin panel.
    // Keeping these permissive so production keeps working.
    // Tighten in Phase 4 once apps are updated.
    // ---------------------------------------------------------------
    match /store/{rest=**}            { allow read, write: if true; }
    match /id_images/{file}           { allow read, write: if true; }
    match /pet_type_images/{file}     { allow read, write: if true; }
    match /communities/{rest=**}      { allow read, write: if true; }
    match /community_posts/{rest=**}  { allow read, write: if true; }
    match /services/{rest=**}         { allow read, write: if true; }
    match /Services_Categories/{rest=**} { allow read, write: if true; }
    match /service_places/{rest=**}   { allow read, write: if true; }
    match /service_requests/{rest=**} { allow read, write: if true; }
    match /friendly_pet_places/{rest=**} { allow read, write: if true; }
    match /sponsored_campaigns/{rest=**} { allow read, write: if true; }
    match /banners/{rest=**}          { allow read, write: if true; }
    match /News/{rest=**}             { allow read, write: if true; }
    match /feature_locks/{file}       { allow read, write: if true; }

    // Default deny for any new top-level paths not listed above.
    // It grants nothing, so telehealth/ is only governed by its rule above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
